{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the Si-Dongle-L",
        "description": "Enter the dongle's IP address and the serial number printed on it. The serial is used as the password for the dongle's encrypted protocol and is never stored in plain text outside this entry.",
        "data": {
          "host": "Host",
          "dongle_serial": "Dongle serial number",
          "scan_interval": "Polling interval (seconds)"
        },
        "data_description": {
          "host": "IP address or hostname of the Si-Dongle-L WiFi dongle (port 7078).",
          "dongle_serial": "Serial number printed on the dongle, e.g. DGLxxxxxxxx.",
          "scan_interval": "How often to poll the inverter. Minimum 15 s. Leave at 30 s unless you know the dongle can take faster polling."
        }
      },
      "reconfigure": {
        "title": "Update the dongle address",
        "description": "Change the IP address of the existing dongle. The dongle serial is kept.",
        "data": {
          "host": "Host"
        }
      },
      "reauth_confirm": {
        "title": "Re-enter the dongle serial",
        "description": "The dongle rejected the stored serial number. Enter the serial printed on the dongle.",
        "data": {
          "dongle_serial": "Dongle serial number"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to the dongle at that address.",
      "invalid_auth": "The dongle rejected the serial number (HMAC mismatch). Check the serial printed on the dongle.",
      "unknown": "Unexpected error. Check the Home Assistant log for details."
    },
    "abort": {
      "already_configured": "This inverter is already configured."
    }
  },
